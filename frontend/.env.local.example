# Copy to frontend/.env.local for local dev. On Vercel, set these under
# Project Settings -> Environment Variables instead.
#
# NEXT_PUBLIC_* vars are bundled into client-side JS and visible to anyone —
# that's fine for the anon key (it's meant to be public; Supabase's Row
# Level Security is what actually protects data). Never put the
# service_role key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
