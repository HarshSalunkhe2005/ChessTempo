# Copy to backend/.env for local dev. On Render, set these in the
# service's Environment tab instead — never commit real values.

SUPABASE_URL=https://your-project.supabase.co
# service_role key — full DB access. Server-side only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> JWT Settings -> JWT Secret, used to verify frontend auth tokens.
SUPABASE_JWT_SECRET=

STOCKFISH_PATH=stockfish
MODEL_CHECKPOINT_PATH=checkpoints/tempo_best.pt
# Optional: if MODEL_CHECKPOINT_PATH doesn't exist locally, it's downloaded
# from here once and cached — e.g. a Supabase Storage public/signed URL,
# since the checkpoint itself is too large to commit to git.
MODEL_CHECKPOINT_URL=

# Phase 2 personalization: where per-user game shards and fine-tuned
# checkpoints are kept on disk (fine for a single backend instance).
PERSONALIZATION_DATA_DIR=data/users
PERSONALIZATION_CHECKPOINT_DIR=checkpoints/personalized

# Comma-separated list of allowed frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://your-app.vercel.app
